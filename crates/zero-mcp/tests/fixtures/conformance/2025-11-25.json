{
  "schema_version": 1,
  "revision": "2025-11-25",
  "name": "conformance-2025-11-25",
  "exchanges": [
    {
      "name": "initialize negotiates 2025-11-25",
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-11-25",
          "capabilities": {},
          "clientInfo": { "name": "zero" }
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "2025-11-25",
          "capabilities": { "tools": { "listChanged": true } },
          "serverInfo": { "name": "fixture-2025", "version": "1.0.0" }
        }
      },
      "expected": {
        "negotiated_revision": "2025-11-25",
        "result_type": "complete"
      }
    },
    {
      "name": "tools/list parses schemas without resultType",
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "tools/list",
        "params": {}
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "tools": [
            {
              "name": "echo",
              "description": "Return the supplied text.",
              "inputSchema": {
                "type": "object",
                "properties": { "text": { "type": "string" } },
                "required": ["text"],
                "additionalProperties": false
              }
            },
            {
              "name": "add",
              "description": "Add two integers.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "left": { "type": "integer" },
                  "right": { "type": "integer" }
                },
                "required": ["left", "right"]
              }
            }
          ]
        }
      },
      "expected": {
        "tool_names": ["echo", "add"],
        "tool_catalog_hash": "38ae46b1709c1cde",
        "result_type": "complete"
      }
    },
    {
      "name": "tools/call returns complete content",
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/call",
        "params": {
          "name": "echo",
          "arguments": { "text": "hello" }
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "content": [{ "type": "text", "text": "hello from 2025-11-25" }],
          "isError": false
        }
      },
      "expected": {
        "result_type": "complete",
        "content": [{ "type": "text", "text": "hello from 2025-11-25" }]
      }
    },
    {
      "name": "resources/list parses a resource catalogue",
      "request": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "resources/list",
        "params": {}
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": {
          "resources": [
            {
              "uri": "file:///workspace/README.md",
              "name": "readme",
              "mimeType": "text/markdown"
            }
          ]
        }
      },
      "expected": {
        "resource_names": ["readme"]
      }
    },
    {
      "name": "JSON-RPC error is surfaced with its wire code",
      "request": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "tools/call",
        "params": {
          "name": "explode",
          "arguments": {}
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 5,
        "error": { "code": -32602, "message": "Invalid params" }
      },
      "expected": {
        "error_code": -32602
      }
    }
  ]
}
